  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:web": "node scripts/dev-web.mjs",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "app": "tauri dev",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.plugins.json",
    "test": "vitest run",
    "test:rust": "cargo test --workspace",
    "test:e2e": "node e2e/run.mjs",
    "icon": "node scripts/render-icon.mjs && tauri icon design/icon.png && rm -rf src-tauri/icons/android src-tauri/icons/ios src-tauri/icons/64x64.png"
  },
  "dependencies": {
