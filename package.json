    "cmdk": "^1.1.1",
    "d3-force": "^3.0.1",
    "dockview-react": "^8.9.1",
    "dompurify": "^3.5.0",
    "lucide-react": "^1.78.0",
    "marked": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.1",
    "tinykeys": "^4.0.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@itztli/plugin-api": "workspace:*",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.5",
